generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ==================== Enums ====================

enum ModelStatus {
  DRAFT
  ANALYZING
  READY
  REVIEWED
}

enum ComponentType {
  PROCESS
  DATA_STORE
  EXTERNAL_ENTITY
  TRUST_BOUNDARY
}

enum StrideCategory {
  SPOOFING
  TAMPERING
  REPUDIATION
  INFO_DISCLOSURE
  DENIAL_OF_SERVICE
  ELEVATION_OF_PRIVILEGE
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum ThreatStatus {
  OPEN
  MITIGATED
  ACCEPTED
  OUT_OF_SCOPE
}

enum ReviewStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MemberRole {
  OWNER
  EDITOR
  REVIEWER
  VIEWER
}

// ==================== Models ====================

model User {
  id        String   @id @default(uuid())
  entraId   String   @unique // Azure AD object ID
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ThreatModelMember[]
  comments    Comment[]

  @@map("users")
}

model ThreatModel {
  id          String      @id @default(uuid())
  name        String
  description String?
  repoUrl     String?
  version     Int         @default(1)
  status      ModelStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  diagrams     Diagram[]
  threats      Threat[]
  chatMessages ChatMessage[]
  reviews      Review[]
  members      ThreatModelMember[]
  shareLinks   ShareLink[]

  @@map("threat_models")
}

model ThreatModelMember {
  id   String     @id @default(uuid())
  role MemberRole @default(VIEWER)

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  threatModelId String
  threatModel   ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, threatModelId])
  @@map("threat_model_members")
}

model ShareLink {
  id        String     @id @default(uuid())
  token     String     @unique @default(uuid())
  role      MemberRole @default(VIEWER)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  expiresAt DateTime?

  threatModelId String
  threatModel   ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)

  @@map("share_links")
}

model Diagram {
  id          String   @id @default(uuid())
  name        String   // e.g., "Enrollment", "Authentication"
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threatModelId String
  threatModel   ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)

  components Component[]
  dataFlows  DataFlow[]

  @@map("diagrams")
}

model Component {
  id          String        @id @default(uuid())
  name        String
  type        ComponentType
  description String?
  sourceFiles String[]
  positionX   Float         @default(0)
  positionY   Float         @default(0)
  metadata    Json?

  diagramId String
  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  outgoingFlows DataFlow[] @relation("source")
  incomingFlows DataFlow[] @relation("target")
  threats       Threat[]
  comments      Comment[]

  @@map("components")
}

model DataFlow {
  id                   String  @id @default(uuid())
  label                String
  protocol             String?
  dataClassification   String?
  crossesTrustBoundary Boolean @default(false)
  metadata             Json?

  sourceId  String
  source    Component @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Component @relation("target", fields: [targetId], references: [id], onDelete: Cascade)
  diagramId String
  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  threats  Threat[]
  comments Comment[]

  @@map("data_flows")
}

model Threat {
  id              String         @id @default(uuid())
  title           String
  description     String
  strideCategory  StrideCategory
  severity        Severity
  status          ThreatStatus   @default(OPEN)
  mitigationNotes String?
  aiGenerated     Boolean        @default(true)
  confidence      Float?

  threatModelId String
  threatModel   ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)
  componentId   String?
  component     Component?  @relation(fields: [componentId], references: [id], onDelete: SetNull)
  dataFlowId    String?
  dataFlow      DataFlow?   @relation(fields: [dataFlowId], references: [id], onDelete: SetNull)

  comments Comment[]

  @@map("threats")
}

model Comment {
  id        String   @id @default(uuid())
  body      String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolved  Boolean  @default(false)

  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  threatId    String?
  threat      Threat?    @relation(fields: [threatId], references: [id], onDelete: Cascade)
  componentId String?
  component   Component? @relation(fields: [componentId], references: [id], onDelete: Cascade)
  dataFlowId  String?
  dataFlow    DataFlow?  @relation(fields: [dataFlowId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("replies")

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@map("comments")
}

model Review {
  id           String       @id @default(uuid())
  name         String
  status       ReviewStatus @default(IN_PROGRESS)
  reviewerName String?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?

  threatModelId String
  threatModel   ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)
  comments      Comment[]

  @@map("reviews")
}

model ChatMessage {
  id        String   @id @default(uuid())
  role      String   // user, assistant, system
  content   String
  timestamp DateTime @default(now())

  threatModelId String
  threatModel   ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model CodeEmbedding {
  id            String                  @id @default(uuid())
  filePath      String
  chunkIndex    Int
  content       String
  embedding     Unsupported("vector(1536)")
  threatModelId String

  @@index([threatModelId])
  @@map("code_embeddings")
}
