{
  "name": "superior-tmt",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered threat modeling tool",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev -w packages/frontend -- --host",
    "dev:backend": "npm run dev -w packages/backend",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w packages/backend",
    "db:generate": "npm run db:generate -w packages/backend",
    "db:seed": "npm run db:seed -w packages/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
